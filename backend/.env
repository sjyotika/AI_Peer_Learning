# Copy this file to .env and fill in values before running the backend.

# Required for Gemini-powered Socratic Q&A and evaluation.
GEMINI_API_KEY=//insert api key here

# Optional: if omitted, backend uses in-memory storage for sessions.
MONGODB_URI=
# Optional frontend origin for CORS in production deployments.
# FRONTEND_ORIGIN=https://your-frontend-domain.com
